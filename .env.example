# Copy to .env. Never commit .env.
# One file at the repo root serves the API, the risk API, the migrations, the web app and the scripts that load dotenv.
# A shell variable wins over this file. apps/web/.env.local, if present, wins over it for the web app.
# Not read by: pnpm risk:retier, risk:routing-gap, risk:pareto, risk:discover and depth:snapshot. Export the variable in the shell for those.
# pnpm risk:collect also sources this file with sh: quote any value that contains & or a space.
# A line written "# NAME=value" is optional and commented out; the value is the default the code uses when unset.

# --- Chain and RPC ---
SOLANA_RPC_URL=                 # required; private RPC endpoint. API routes that touch the chain, the pool collector, its installer and the scripts under scripts/checks and scripts/mainnet fail without it; the risk scripts fall back to the rate-limited public RPC
SOLANA_RPC_URL_FALLBACK=        # optional; second provider (returned by rpcUrls(), no caller switches to it yet)
RISK_SOLANA_RPC_URL=            # optional; a mainnet RPC for GET /risk/pools/:address/liquidity alone, where SOLANA_RPC_URL is a test network's (the hosted API on devnet). Unset: SOLANA_RPC_URL
# ROBINHOOD_RPC_URL=             # required when CHAIN_MODE_ROBINHOOD is live or readonly; a Robinhood Chain node held to its deploy record's chain id. The API and the keeper read it
DEMO_WALLET_KEYPAIR_PATH=./secrets/demo-wallet.json   # optional, default shown; gitignored demo wallet that signs in scripts (pnpm wallet:create writes it)

# --- Jupiter ---
JUPITER_API_KEY=                # from portal.jup.ag; optional for quotes (the keyless tier is tightly rate-limited), needed for execution
JUPITER_API_BASE=https://api.jup.ag/swap/v1   # optional, default shown

# --- LLM (goal parsing only; any OpenAI-compatible endpoint; leave empty to use the deterministic rules parser) ---
LLM_BASE_URL=                   # e.g. https://openrouter.ai/api/v1; the LLM is called only when this and the model are both set
LLM_API_KEY=                    # optional; sent as a Bearer token when set
LLM_MODEL=                      # model id as the endpoint names it

# --- Database ---
DATABASE_URL=postgres://colosseum:colosseum@localhost:5433/colosseum   # optional, default shown; matches docker-compose.yml
# DB_POOL_MAX=10   # optional; the most connections one process holds (1 to 100). A hosted pooler in session mode caps the clients of a whole project (Supabase's: `pool_size`, 15 by default), and the cap counts every process at once: each API instance (two overlap during a deploy), the keeper, a migration (one connection) and any script, each with its own pool. Past it a query fails with EMAXCONNSESSION. The API holds one pool for all its routes
# DB_PGBOUNCER=transaction   # optional; set it when DATABASE_URL goes through a pooler in transaction mode (Supabase's on port 6543): the driver then prepares no statements, which such a pooler cannot keep. Left out: as the address says, prepared by default. Migrations (`pnpm db:migrate`) run over the session-mode or direct address, never the transaction pooler's

# --- The guided intake's model (apps/api/src/llm.ts) ---
# ANTHROPIC_API_KEY=   # optional; with none the intake reads with the rules parser alone, and its answers say so (`reader.why`: model_not_configured)
# INTAKE_MODEL=claude-haiku-4-5   # optional, default shown; the model that reads a goal into fields
# INTAKE_MODEL_TIMEOUT_MS=6000    # optional, default shown; one call's time, 500 to 60000. Past it the rules parser reads (model_timeout)
# INTAKE_MODEL_DAILY_CALLS=1000   # optional, default shown; calls a day for everyone
# INTAKE_MODEL_DAILY_CALLS_PER_PERSON=30   # optional, default shown; calls a day for one person. A value the server cannot read stops it at start, naming the variable
# VAULT_AGENT_MODEL=claude-haiku-4-5   # optional; the vault and new-goal conversation's model. Unset: the intake's INTAKE_MODEL. Shares the intake's daily budgets
# VAULT_AGENT_TIMEOUT_MS=30000   # optional, default shown; one conversation call's time, 1000 to 120000. A reply that fails a check gets one repair call; both together stay within this plus 15000
# VAULT_AGENT_EFFORT=low   # optional, default shown; low, medium or high. Sent only to models that take output_config.effort (Claude 5 family, Opus 4.5+, Sonnet 4.6); their thinking shares the 16,000-token output budget
# GOAL_AGENT=relaxed   # optional, default shown; relaxed | model-led: which conversation answers on /goal. Any other value stops the API at start
# RELAXED_MODEL=claude-sonnet-5-5   # optional, default shown; the model of the relaxed intake on /goal, used only when ANTHROPIC_API_KEY is set

# --- API and web ---
API_PORT=3001                   # optional, default shown; apps/api listen port
PUBLIC_API_URL=http://localhost:3001        # optional, default shown; server URL printed in the API's OpenAPI docs
RISK_API_PORT=3002              # optional, default shown; apps/risk-api listen port
PUBLIC_RISK_API_URL=http://localhost:3002   # optional, default shown; server URL printed in the risk API's OpenAPI docs
NEXT_PUBLIC_API_URL=http://localhost:3001   # optional, default shown; where the web app and pnpm sign-and-send reach the API
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com   # optional, default shown; browser wallet connection. Shipped in client code: never a URL that carries a key
NEXT_PUBLIC_PRIVY_APP_ID=cmur8imaq00b40cl5eqy1lrwb   # sign-in; the Privy app id of the development app (allowed origin http://localhost:3000). Public: it ships in client code. Without it the "Sign in" button is off and says so
# NEXT_PUBLIC_CHAIN_NETWORK_SOLANA=testnet   # optional; mainnet | testnet: the network the browser wallet signs for. Takes _SOLANA, _ROBINHOOD or _BASE. Keep each equal to its CHAIN_NETWORK_<CHAIN> below; `local` is refused, since a signature for a copy of mainnet is valid on mainnet
# NEXT_PUBLIC_CHAIN_READ_RPC_SOLANA=   # optional; one node of the chain (https, no key), for the order screen's own read of whether a signature can still land. Takes _SOLANA, _ROBINHOOD or _BASE. Unset, a step is never signed twice without the person's word. Not a URL that balances calls across nodes
# NEXT_PUBLIC_WALLET_DRIVER=      # optional; "test" puts a throwaway wallet made in the browser in place of Privy, for work on the mock. Read under `pnpm dev` only: a production build ignores it, and the build fails if that wallet is in it
# NEXT_PUBLIC_RISK_API_URL=     # optional; where the web app reads the /risk routes when they run on their own (apps/risk-api). Default: NEXT_PUBLIC_API_URL, which mounts them
# EMBED_FRAME_ANCESTORS=        # optional; partner origins that may frame /embed, space-separated, each https://host[:port] exactly. Read when the web app is built
# RISK_LIQUIDITY=               # optional; "off" makes the API plan without the risk layer's stored depth curves
# REPO_ROOT=                    # optional; repo root the API reads fixtures/risk from. Default: derived from the source file's location

# --- Vault: flags and chains (parseFlags and parseChainConfigs in packages/schemas; served at GET /v1/config) ---
# Each per-chain name takes _SOLANA, _ROBINHOOD or _BASE. The API stops at start on a value it does not know, and on
# any other set name that begins with CHAIN_, AUTO_FOLLOW_ or KEEPER_ (a typo is not a default).
# CHAIN_MODE_SOLANA=mock        # optional; live | readonly | mock | off. mock runs on packages/chain-mock and touches no chain. Default: mock, and off for Base. live and readonly need a router, a price account (Solana) and our deployments
# CHAIN_NETWORK_SOLANA=testnet  # optional; mainnet | testnet | local. testnet is devnet, Robinhood Chain testnet (46630) and Base Sepolia; local is a copy of mainnet. One database serves one network
# CHAIN_ROUTER_SOLANA=          # optional; the exchange a vault may trade through on that network: an address of the chain's own family, 0x in any case. Test networks have none of their own: set it after the deploy
# CHAIN_PRICE_SOURCE_SOLANA=    # optional; Solana: the Scope-layout price account. mainnet and local already carry Kamino's; devnet has none until our deploy. On EVM the feeds are per asset
# AUTO_FOLLOW_SOLANA=off        # optional; on | off
# KEEPER_ENABLED=off            # optional; on | off
# AGENT_SURFACE=off             # optional; on | off

# --- Vault: sign-in (apps/api/src/plugins/auth.ts) ---
# PRIVY_APP_ID=                 # the Privy app whose tokens the API trusts: an id, not a secret. Unset means nobody can sign in: every /v1 route that needs a person answers 503
# PRIVY_JWKS_URL=               # optional; where that app's public keys are read, https only. Default: https://auth.privy.io/api/v1/apps/<PRIVY_APP_ID>/jwks.json

# --- Vault: who may call /v1 from a browser (apps/api/src/plugins/cors.ts) ---
# CORS_ORIGINS=http://localhost:3000   # optional; the origins a browser may call /v1 from, separated by commas, each a scheme and a host with no path. Default: the web app under pnpm dev. "none" allows no origin. A star is refused. The other routes (/risk/*, the structurer's) answer any origin, as before
# TRUST_PROXY_HOPS=0   # optional; how many proxies the host puts in front of the API (0 to 5). Unset or 0: a request is counted against the address its connection came from, so behind a proxy everybody not signed in shares one rate limit. Set it to the host's number and each caller is counted by the address the proxies wrote (apps/api/src/plugins/proxy.ts). Too high a number lets a caller write their own address. To find it: after a deploy the API logs "forwarded hops seen: N" the first time it sees each count. Set the LOWEST N logged: a caller can add entries, so a count can be too high and never too low
# CSP_REPORT_URI=https://reports.example/csp   # optional, for the web; where a browser sends what breaks the policy it only reports on (apps/web/lib/content-policy.ts). Unset: the browser's console only

# --- Risk layer: paths ---
# RISK_DATA_DIR=data/risk       # optional; discovery, registry and history files (gitignored)
# RISK_HOME=                    # optional; collector output and registry.json. Default: ~/.colosseum/risk
# RISK_HOLIDAYS=fixtures/risk/us-market-holidays.json   # optional; US market calendar behind the time-of-week regimes
# DEPTH_DIR=                    # optional; depth cron JSONL. Default: data/depth for pnpm depth:snapshot, ~/.colosseum/depth for pnpm depth:import and the launchd job
# RISK_SPLIT_DIR=               # optional; the API's split-route files. Default: <RISK_DATA_DIR or ~/.colosseum/risk/data>/split
# RISK_RAW_DIR=                 # optional; the API's recorded pool files. Default: ~/.colosseum/risk/raw
# RISK_RAW_ARRAYS_DIR=          # optional; the raw-arrays job's folder the API reads. Default: ~/.colosseum/risk/raw-arrays

# --- Risk layer: collectors and curve parameters ---
# The launchd jobs read ~/.colosseum/risk/env, not this file. The installer copies only the RPC URL and the Jupiter key
# there, so put collector overrides in that file.
# RISK_MAX_DISCOVERIES=40       # optional; child-account re-discoveries (getProgramAccounts) per pool-collector run
# RISK_WITHDRAWAL_ALARM=0.2     # optional; share of in-band depth lost in one run that logs an LP-withdrawal event
# RISK_LP_EXIT_N=3              # optional; largest in-band positions removed in the LP-exit stress
# RISK_QUOTE_SPACING_MS=1300    # optional; delay between Jupiter quotes in the cross-check collector
# RISK_CURVE_QUANTILE=0.5       # optional; quantile of observed sell cost that pnpm risk:compute fits per regime
# RISK_MIN_SAMPLES=8            # optional; samples a grid point needs before its curve counts as sufficient
# RISK_GAP_FLAG=0.002           # optional; pnpm risk:routing-gap flags a pool when the simulation beats Jupiter by more than this share
# TIER_A_SHARE=0.99             # optional; share of TVL whose pools get tier A (5-minute refresh) in pnpm risk:registry and risk:retier
# MIN_POOL_TVL_USD=1000         # optional; pnpm risk:retier marks pools below this TVL as tier X (kept, not collected)

# --- EVM depth collector (pnpm risk-evm:collect, pnpm risk-evm:import) ---
# It measures the real pools on mainnet, read-only, whatever network the product itself runs on.
# RISK_EVM_RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com   # optional; Robinhood Chain mainnet (4663). Default: the free public RPC shown. A URL set here is never written to a row or a log
# RISK_EVM_BASE_RPC_URL=https://mainnet.base.org                # optional; Base mainnet (8453), used only with --chain base while Base is switched off
# RISK_EVM_DIR=data/risk-evm    # optional; where the collector appends rows and keeps its pool list, and where the import reads them (gitignored)
# RISK_EVM_INTERVAL_MIN=60      # optional; minutes between runs of pnpm risk-evm:collect --loop
# RISK_EVM_MAX_POOLS=3          # optional; deepest dollar pools quoted per token

# --- Keeper (apps/keeper): its own environment, never this file ---
# The API refuses a KEEPER_ name it does not know, so these go only where the keeper runs (scripts/keeper/run.sh).
# KEEPER_CHAIN=solana           # optional, default shown; solana | robinhood, one chain a process
# KEEPER_STATE_DIR=             # optional; the legs it sent and has not settled. Default: ~/.tenonfi/keeper
# KEEPER_SOLANA_KEYPAIR=        # path to the keeper's Solana key file, outside the repo. Never a key itself
# KEEPER_ROBINHOOD_KEY=         # path to the keeper's Robinhood Chain key file, outside the repo. Never a key itself
# KEEPER_POOL_FEEDS=            # optional; the pool-feed file of the mainnet dry run. Default: contracts/script/config/pool-feeds/4663.json
# KEEPER_LOW_GAS=               # optional; below this balance, in the chain's smallest unit, the keeper alerts. Default: 50000000 lamports on Solana, 500000000000000 wei (0.0005 ETH) on Robinhood Chain
# KEEPER_INTERVAL=60            # optional, default shown; seconds between rounds in scripts/keeper/run.sh
# KEEPER_DISCORD_WEBHOOK=       # optional; where alerts are posted. Holds a secret: never printed
# KEEPER_HEALTHCHECK_URL=       # optional; a healthchecks.io URL pinged after each round. Holds a secret: never printed

# --- Snapshot worker (apps/snapshot) ---
# SNAPSHOT_PING_URL=            # optional; a healthchecks.io URL pinged after each pass. Holds a secret: never printed

# --- MCP server (apps/mcp): its own environment ---
# TENONFI_API_URL=https://tenonfi-api.onrender.com   # optional, default shown; the API it calls
# TENONFI_APP_URL=              # required unless it listens on this machine alone (then http://localhost:3000); where the approval links point
# PORT=8787                     # optional, default shown; the host usually sets it
# HOST=0.0.0.0                  # optional, default shown
# MCP_ALLOWED_ORIGINS=          # optional; browser origins allowed to call /mcp, comma-separated. Default: none

# --- Per-run flags: pass on the command line (NAME=1 pnpm ...), do not set them here ---
# RISK_FORCE_ALL=               # 1 = pnpm risk:collect snapshots every tier now instead of waiting for the hourly window
# SKIP_SEARCH=                  # 1 = pnpm risk:registry skips the on-chain pool search by mint
# POSITIONS=                    # 1 = scripts/risk/capture-pool-fixture.ts also stores the pool's positions (Raydium, Orca)
# OUT_FEE_BPS=                  # output token's transfer fee in bps, for capture-pool-fixture.ts and validate-cpmm.ts; unset means none
# WALLET_OVERWRITE=             # 1 = pnpm wallet:import may replace an existing keypair file
# NODE_ENV=                     # set by tooling; "test" turns the API loggers off
