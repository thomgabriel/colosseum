# Copy to .env. Never commit .env.
# --- Chain ---
SOLANA_RPC_URL=                 # paid RPC (Helius/Triton); public RPC is rate-limited
SOLANA_RPC_URL_FALLBACK=        # second provider, used when the first times out
DEMO_WALLET_KEYPAIR_PATH=./secrets/demo-wallet.json   # gitignored; founder's demo wallet
AGENT_KEYPAIR_PATH=./secrets/agent.json              # gitignored; policy executor key (mechanism A only)
# --- Jupiter ---
JUPITER_API_KEY=                # from portal.jup.ag; quote works keyless at a low tier (V2)
JUPITER_API_BASE=https://api.jup.ag/swap/v1
# --- LLM (goal parsing only; any OpenAI-compatible endpoint; leave empty to use the deterministic rules parser) ---
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# --- Database ---
DATABASE_URL=postgres://colosseum:colosseum@localhost:5433/colosseum
# --- Nora (BRS) - filled only after gate G-Nora passes ---
NORA_API_BASE=
NORA_API_KEY=
# --- App ---
API_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001
