{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "maxSize": 16777216,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/.next",
      "!contracts/out",
      "!contracts/cache",
      "!contracts/broadcast",
      "!**/migrations/meta",
      "!data",
      "!secrets",
      "!coverage",
      "!.design",
      "!.claude/settings.local.json",
      "!.claude/worktrees",
      "!**/next-env.d.ts",
      "!**/target",
      "!**/.anchor",
      "!**/test-ledger",
      "!keys",
      "!idl"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  }
}
