{
  "name": "colosseum",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "db:generate": "pnpm --filter @colosseum/db generate",
    "db:migrate": "pnpm --filter @colosseum/db migrate",
    "plan:demo": "tsx scripts/plan-demo.ts",
    "execute:demo": "tsx scripts/execute-demo.ts",
    "verify:all": "tsx scripts/verify/run-all.ts",
    "depth:snapshot": "node scripts/depth-snapshot.mjs",
    "depth:install-cron": "zsh scripts/launchd/install.sh",
    "db:seed": "pnpm --filter @colosseum/db seed",
    "depth:import": "tsx scripts/depth-import.ts",
    "wallet:create": "tsx scripts/wallet-create.ts",
    "check:d1pm": "tsx scripts/checks/d1pm-simulate.ts",
    "wallet:export": "tsx scripts/wallet-export.ts",
    "wallet:import": "tsx scripts/wallet-import.ts",
    "sign-and-send": "tsx scripts/sign-and-send.ts",
    "fixture:plan": "tsx scripts/fixtures/insert-fixture-plan.ts",
    "feeds:refresh": "tsx scripts/feeds/refresh.ts",
    "schedule:export": "tsx scripts/schedule-export.ts",
    "acceptance": "tsx scripts/acceptance.ts",
    "risk:discover": "tsx scripts/risk/discover-pools.ts",
    "risk:pareto": "tsx scripts/risk/pool-pareto.ts",
    "risk:registry": "tsx scripts/risk/build-registry.ts",
    "risk:collect": "set -a && . ./.env && set +a && RISK_FORCE_ALL=${RISK_FORCE_ALL:-0} tsx scripts/risk/collector/pools.ts",
    "risk:install-collector": "zsh scripts/risk/collector/install.sh",
    "risk:coverage": "tsx scripts/risk/coverage.ts",
    "risk:retier": "tsx scripts/risk/retier.ts",
    "risk:import": "tsx scripts/risk/import.ts",
    "risk:compute": "tsx scripts/risk/compute.ts",
    "risk:history": "tsx scripts/risk/history-backfill.ts",
    "risk:history-measure": "tsx scripts/risk/history-full-measure.ts",
    "risk:history-full": "tsx scripts/risk/history-full.ts",
    "risk:history-verify": "tsx scripts/risk/history/verify.ts",
    "risk:history-reconstruct": "tsx scripts/risk/history/reconstruct.ts",
    "risk:history-report": "tsx scripts/risk/history/report.ts",
    "risk:routing-gap": "tsx scripts/risk/routing-gap.ts",
    "risk:markets": "tsx scripts/risk/verify-markets.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@kamino-finance/klend-sdk": "^12.0.1",
    "@solana/kit": "^2.3.0",
    "@types/node": "^22.15.0",
    "dotenv": "^16.4.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3",
    "drizzle-orm": "^0.45.3",
    "zod": "^4.6.5",
    "@solana-program/compute-budget": "^0.9.0"
  }
}
