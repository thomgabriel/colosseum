{
  "name": "colosseum",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @colosseum/api --filter @colosseum/web dev",
    "dev:devnet": "bash scripts/dev/devnet-local.sh",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contracts": "cd contracts && forge test",
    "test:program": "pnpm --dir programs/tests install --frozen-lockfile && pnpm --dir programs/tests test",
    "typecheck": "pnpm -r typecheck",
    "verify:quick": "pnpm lint && pnpm typecheck && tsc -p tsconfig.json",
    "verify": "pnpm verify:quick && pnpm test && pnpm build",
    "db:up": "docker compose up -d --wait postgres && pnpm db:migrate",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "db:generate": "pnpm --filter @colosseum/db generate",
    "db:migrate": "pnpm --filter @colosseum/db migrate",
    "plan:demo": "tsx scripts/plan-demo.ts",
    "plan:try": "tsx scripts/try/main.ts",
    "plan:compare": "tsx scripts/try/compare.ts",
    "execute:demo": "tsx scripts/execute-demo.ts",
    "verify:all": "tsx scripts/verify/run-all.ts",
    "depth:snapshot": "node scripts/depth-snapshot.mjs",
    "depth:install-cron": "zsh scripts/launchd/install.sh",
    "db:seed": "tsx scripts/seed-assets.ts",
    "openapi:emit": "pnpm --filter @colosseum/api openapi && biome format --write packages/sdk/openapi.json",
    "depth:import": "tsx scripts/depth-import.ts",
    "wallet:create": "tsx scripts/wallet-create.ts",
    "check:d1pm": "tsx scripts/checks/d1pm-simulate.ts",
    "wallet:export": "tsx scripts/wallet-export.ts",
    "wallet:import": "tsx scripts/wallet-import.ts",
    "sign-and-send": "tsx scripts/mainnet/sign-and-send.ts",
    "fixture:plan": "tsx scripts/fixtures/insert-fixture-plan.ts",
    "feeds:refresh": "tsx scripts/feeds/refresh.ts",
    "feeds:refresh-models": "tsx scripts/feeds/refresh-models.ts",
    "schedule:export": "tsx scripts/schedule-export.ts",
    "acceptance": "tsx scripts/acceptance.ts",
    "risk:discover": "tsx scripts/risk/discover-pools.ts",
    "risk:pareto": "tsx scripts/risk/pool-pareto.ts",
    "risk:registry": "tsx scripts/risk/build-registry.ts",
    "risk:collect": "set -a && . ./.env && set +a && RISK_FORCE_ALL=${RISK_FORCE_ALL:-0} tsx scripts/risk/collector/pools.ts",
    "risk:install-collector": "zsh scripts/risk/collector/install.sh",
    "risk:coverage": "tsx scripts/risk/coverage.ts",
    "risk:retier": "tsx scripts/risk/retier.ts",
    "risk:freeze-universe-fixture": "tsx scripts/risk/freeze-universe-fixture.ts",
    "risk:universe": "tsx scripts/risk/universe/build.ts",
    "risk:freeze-list-fixtures": "tsx scripts/risk/universe/freeze-fixtures.ts",
    "risk:import": "tsx scripts/risk/import.ts",
    "risk:compute": "tsx scripts/risk/compute.ts",
    "risk:history": "tsx scripts/risk/history-backfill.ts",
    "risk:history-measure": "tsx scripts/risk/history-full-measure.ts",
    "risk:history-full": "tsx scripts/risk/history-full.ts",
    "risk:history-verify": "tsx scripts/risk/history/verify.ts",
    "risk:history-reconstruct": "tsx scripts/risk/history/reconstruct.ts",
    "risk:history-report": "tsx scripts/risk/history/report.ts",
    "risk:routing-gap": "tsx scripts/risk/routing-gap.ts",
    "risk:markets": "tsx scripts/risk/verify-markets.ts",
    "risk:provider-check": "tsx scripts/risk/facts/provider-check.ts",
    "risk:facts": "tsx scripts/risk/facts/asset-facts.ts",
    "risk:facts-plan": "tsx scripts/risk/facts/plan-facts.ts",
    "risk:facts-lending": "tsx scripts/risk/facts/lending-facts.ts",
    "risk:facts-import": "tsx scripts/risk/facts/import-lending.ts",
    "risk:recovery-import": "tsx scripts/risk/facts/import-recovery.ts",
    "risk:flow-import": "tsx scripts/risk/facts/import-flow.ts",
    "risk:freeze-flow-fixture": "tsx scripts/risk/facts/freeze-flow-fixture.ts && biome format --write fixtures/risk/history/flow-tslax.json",
    "risk:facts-methodology": "tsx scripts/risk/facts/gen-methodology.ts",
    "risk:split-snapshot": "tsx scripts/risk/split-snapshot.ts",
    "risk:split-capture": "tsx scripts/risk/split-capture.ts",
    "risk:cost-breakdown": "tsx scripts/risk/facts/cost-breakdown.ts",
    "risk:network-fees": "tsx scripts/risk/facts/network-fees.ts",
    "risk:freeze-market-fixture": "tsx scripts/risk/facts/freeze-market-fixture.ts && biome format --write fixtures/risk/prices/market-series.json",
    "risk:freeze-oracle-fixture": "tsx scripts/risk/facts/freeze-oracle-fixture.ts && biome format --write fixtures/risk/oracle",
    "risk:freeze-split-fixture": "tsx scripts/risk/facts/freeze-split-fixture.ts && biome format --write fixtures/risk/split",
    "risk:lending-measure": "tsx scripts/risk/lending-measure.ts",
    "risk:lending-registry": "tsx scripts/risk/lending-registry.ts",
    "risk:lending-history": "tsx scripts/risk/lending-history.ts",
    "risk:lending-ix-table": "tsx scripts/risk/lending-ix-table.ts",
    "risk:lending-decode": "tsx scripts/risk/lending-decode.ts",
    "risk:lending-decode-check": "tsx scripts/risk/lending-decode-check.ts",
    "risk:lending-freeze-tx-fixtures": "tsx scripts/risk/lending-freeze-tx-fixtures.ts",
    "risk:lending-verify": "tsx scripts/risk/lending-verify.ts",
    "risk:lending-gap-scan": "tsx scripts/risk/lending-gap-scan.ts",
    "risk:lending-freeze-reconstruct-fixtures": "NODE_OPTIONS=--max-old-space-size=8192 tsx scripts/risk/lending-freeze-reconstruct-fixtures.ts",
    "risk:lending-freeze-import-fixtures": "tsx scripts/risk/lending-freeze-import-fixtures.ts",
    "risk:lending-import-check": "NODE_OPTIONS=--max-old-space-size=8192 tsx scripts/risk/lending-import-check.ts",
    "risk:lending-import": "NODE_OPTIONS=--max-old-space-size=8192 tsx scripts/risk/lending-import.ts",
    "risk:lending-reconstruct": "NODE_OPTIONS=--max-old-space-size=12288 tsx scripts/risk/lending-reconstruct.ts",
    "risk:lending-freeze-report-fixtures": "tsx scripts/risk/lending-freeze-report-fixtures.ts",
    "risk:lending-freeze-liquidation-fixtures": "tsx scripts/risk/lending-freeze-liquidation-fixtures.ts",
    "risk:lending-follow": "tsx scripts/risk/lending-follow.ts",
    "risk:lending-freeze-follow-fixtures": "tsx scripts/risk/lending-freeze-follow-fixtures.ts && biome format --write fixtures/risk/lending/follow.json",
    "risk:lending-report": "NODE_OPTIONS=--max-old-space-size=8192 tsx scripts/risk/lending-report.ts",
    "risk:lending-freeze-verify-fixtures": "NODE_OPTIONS=--max-old-space-size=8192 tsx scripts/risk/lending-freeze-verify-fixtures.ts",
    "risk:prices-extract": "NODE_OPTIONS=--max-old-space-size=8192 tsx scripts/risk/prices/extract.ts",
    "risk:prices-validate": "NODE_OPTIONS=--max-old-space-size=8192 tsx scripts/risk/prices/validate.ts",
    "risk:prices-import": "NODE_OPTIONS=--max-old-space-size=8192 tsx scripts/risk/prices/import.ts",
    "risk:prices-job": "tsx scripts/risk/prices/job.ts",
    "risk:prices-install-job": "zsh scripts/risk/prices/install-job.sh",
    "risk:prices-freeze-fixtures": "tsx scripts/risk/prices/freeze-fixtures.ts && biome format --write fixtures/risk/prices",
    "risk:raw-arrays": "tsx scripts/risk/raw-arrays/job.ts",
    "risk:raw-arrays-check": "tsx scripts/risk/raw-arrays/check.ts",
    "risk:raw-arrays-install-job": "zsh scripts/risk/raw-arrays/install-job.sh",
    "risk:venues": "tsx scripts/risk/venues/report.ts",
    "risk:venues-freeze-pools": "tsx scripts/risk/venues/freeze-pools.ts",
    "risk:venues-freeze-byreal": "tsx scripts/risk/venues/freeze-byreal.ts",
    "risk:venues-freeze-fixtures": "tsx scripts/risk/venues/freeze-fixtures.ts",
    "risk:byreal-pools": "tsx scripts/risk/byreal/pools.ts",
    "risk:byreal-validate": "tsx scripts/risk/byreal/validate.ts",
    "risk:byreal-report": "tsx scripts/risk/byreal/report.ts",
    "risk:byreal-freeze-fixture": "tsx scripts/risk/byreal/freeze-fixture.ts",
    "risk-evm:collect": "tsx scripts/risk-evm/collect.ts",
    "risk-evm:import": "tsx scripts/risk-evm/import.ts",
    "risk-evm:universe": "tsx scripts/risk-evm/universe.ts",
    "risk-evm:discover": "tsx scripts/risk-evm/discover.ts",
    "risk-evm:pareto": "tsx scripts/risk-evm/pareto.ts",
    "risk-evm:oracles": "tsx scripts/risk-evm/oracles.ts",
    "risk-evm:history": "tsx scripts/risk-evm/history-run.ts",
    "risk-evm:flow-import": "NODE_OPTIONS=--max-old-space-size=8192 tsx scripts/risk-evm/flow-import.ts",
    "ops:authority-check": "tsx scripts/ops/authority-check.ts",
    "ops:mainnet-records": "tsx scripts/ops/mainnet-records.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@colosseum/basket": "workspace:*",
    "@colosseum/chain-evm": "workspace:*",
    "@colosseum/chain-mock": "workspace:*",
    "@colosseum/chain-solana": "workspace:*",
    "@colosseum/db": "workspace:*",
    "@colosseum/engine": "workspace:*",
    "@colosseum/risk": "workspace:*",
    "@colosseum/schemas": "workspace:*",
    "@colosseum/sdk": "workspace:*",
    "@jup-ag/lend": "0.3.0",
    "@jup-ag/lend-read": "0.0.14",
    "@kamino-finance/klend-sdk": "^12.0.1",
    "@solana-program/compute-budget": "^0.9.0",
    "@solana/kit": "^2.3.0",
    "@types/node": "^22.15.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.3",
    "fast-check": "^4.10.2",
    "happy-dom": "20.14.5",
    "litesvm": "1.5.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
